---
import { unicodeCodePoints } from '../lib/unicode';

interface Props {
  symbols: string[];
  groups?: Array<{ name: string; symbols: string[] }>;
}
const { symbols, groups } = Astro.props;

// Group names double as filter chips. Without groups the page shows one flat
// grid and no chips.
const chips = groups?.map((group) => group.name) ?? [];

const cards = (groups?.length
  ? groups.flatMap((group) => group.symbols.map((symbol) => ({ symbol, group: group.name })))
  : symbols.map((symbol) => ({ symbol, group: '' }))
).map((card) => ({
  ...card,
  codePoints: unicodeCodePoints(card.symbol),
}));
---

<section class="panel symbol-panel">
  <div class="symbol-toolbar">
    <label class="sr-only" for="symbolSearch">Search symbols</label>
    <div class="search-field">
      <span class="search-icon" aria-hidden="true">⌕</span>
      <input
        class="symbol-search"
        id="symbolSearch"
        type="search"
        placeholder="Search symbols or Unicode code"
        autocomplete="off"
      />
      <span class="search-shortcut" aria-hidden="true">⌘ K</span>
    </div>
    <button class="toolbar-button" id="copyVisible" type="button">
      <span aria-hidden="true">⧉</span> Copy visible
    </button>
    <span class="result-count" id="resultCount">{cards.length} symbols</span>
  </div>

  {
    chips.length > 0 && (
      <div class="filter-chips" role="group" aria-label="Filter symbols by group">
        <button class="chip active" type="button" data-group-filter="all" aria-pressed="true">
          All
        </button>
        {chips.map((chip) => (
          <button class="chip" type="button" data-group-filter={chip} aria-pressed="false">
            {chip}
          </button>
        ))}
      </div>
    )
  }

  <div class="symbol-cards" id="symbolsGrid">
    {
      cards.map((card) => (
        <div
          class="symbol-card"
          data-symbol={card.symbol}
          data-group={card.group}
          data-search={`${card.symbol} ${card.codePoints}`}>
          <button
            class="fav-toggle"
            type="button"
            data-fav={card.symbol}
            aria-label={`Save ${card.symbol} to your collection`}
            title="Save to collection">
            ♡
          </button>
          <span class="symbol-glyph" title={card.codePoints}>
            {card.symbol}
          </span>
          <button class="copy-action" type="button" data-copy={card.symbol}>
            <span aria-hidden="true">⧉</span> Copy
          </button>
        </div>
      ))
    }
  </div>

  <p class="search-empty" id="searchEmpty" hidden>No symbols match this search.</p>
</section>

<script is:inline>
  (function () {
    const cards = [...document.querySelectorAll('.symbol-card')];
    const searchInput = document.getElementById('symbolSearch');
    const resultCount = document.getElementById('resultCount');
    const copyVisible = document.getElementById('copyVisible');
    const emptyState = document.getElementById('searchEmpty');
    const chips = [...document.querySelectorAll('[data-group-filter]')];
    if (!cards.length) return;

    let activeGroup = 'all';

    function update() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const matchesGroup = activeGroup === 'all' || card.dataset.group === activeGroup;
        const matchesQuery = !query || card.dataset.search.toLowerCase().includes(query);
        const show = matchesGroup && matchesQuery;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (resultCount) {
        resultCount.textContent = `${visible} ${visible === 1 ? 'symbol' : 'symbols'}`;
      }
      if (emptyState) emptyState.hidden = visible !== 0;
    }

    cards.forEach((card) => {
      const symbol = card.dataset.symbol;
      const copyBtn = card.querySelector('.copy-action');
      copyBtn.addEventListener('click', async () => {
        const ok = await window.copyText(symbol);
        if (!ok) return;
        // Brief confirmation on the card that was actually clicked.
        cards.forEach((c) => c.classList.remove('is-copied'));
        card.classList.add('is-copied');
        copyBtn.classList.add('copied');
        clearTimeout(card._t);
        card._t = setTimeout(() => {
          card.classList.remove('is-copied');
          copyBtn.classList.remove('copied');
        }, 1300);
      });
    });

    // Save controls are handled centrally in src/layouts/Base.astro, which
    // delegates clicks and repaints every icon on change.

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeGroup = chip.dataset.groupFilter;
        chips.forEach((c) => {
          const active = c === chip;
          c.classList.toggle('active', active);
          c.setAttribute('aria-pressed', String(active));
        });
        update();
      });
    });

    searchInput?.addEventListener('input', update);
    copyVisible?.addEventListener('click', () => {
      const visible = cards.filter((c) => !c.hidden).map((c) => c.dataset.symbol);
      window.copyText(visible.join(' '));
    });

    // Cmd/Ctrl+K focuses search, matching the hint in the field.
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        searchInput?.focus();
        searchInput?.select();
      }
    });
  })();
</script>
