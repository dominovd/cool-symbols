---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="nav-brand"><span class="mark">✦</span> Cool Symbols</a>
        <p>Copy and paste Unicode symbols for bios, captions, usernames, and messages.</p>
        <div class="footer-socials">
          {
            socials.map((social) => (
              <a href={social.href} rel="nofollow" aria-label={social.name}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={social.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      {
        columns.map((column) => (
          <div class="footer-column">
            <h2>{column.title}</h2>
            {column.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="footer-bottom">
    <span>cool-symbols.net</span>
    <span class="sep">·</span>
    <span>free forever</span>
    <span class="sep">·</span>
    <span>made with ✦ and Unicode</span>
  </div>
</footer>
