---
import {
  SITE_URL,
  SITE_NAME,
  GSC_VERIFICATION,
  ogImage,
  organizationJsonLd,
  webSiteJsonLd,
} from '../lib/seo';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  /** Path without leading slash. Empty string for the home page. */
  path: string;
  /** Any number of objects to emit as <script type="application/ld+json">. */
  jsonLd?: unknown[];
  bodyClass?: string;
  /**
   * Slug of the generated preview image. Defaults to the page path, which is
   * what every page wants; only pass this to borrow another page's card.
   */
  imageSlug?: string;
  /** Describes the preview image for screen readers and image search. */
  imageAlt?: string;
}

const { title, description, path, jsonLd = [], bodyClass, imageSlug, imageAlt } = Astro.props;
const canonical = path ? `${SITE_URL}/${path}` : `${SITE_URL}/`;
const image = ogImage(imageSlug ?? path);

// Organization and WebSite belong on every page: they describe the site rather
// than the document, and repeating them lets any page be the entry point.
const graph = [organizationJsonLd(), webSiteJsonLd(), ...jsonLd];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Runs before the body is parsed. Applies the saved theme so there is no
        light flash, and defines the clipboard helper plus the favourites store
        so component scripts further down the document can use them on parse.
        Both look up DOM nodes lazily for that reason. */}
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}

        // ----- Clipboard -----
        // execCommand fallback covers non-secure contexts and in-app browsers
        // (Instagram / TikTok webviews) where the async API is unavailable.
        function fallbackCopy(text) {
          const el = document.createElement('textarea');
          el.value = text;
          el.setAttribute('readonly', '');
          el.style.position = 'fixed';
          el.style.left = '-9999px';
          document.body.appendChild(el);
          el.select();
          let copied = false;
          try { copied = document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(el);
          return copied;
        }

        window.copyText = async function (text) {
          if (!text) return false;
          let copied = false;
          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(text);
              copied = true;
            }
          } catch (e) {}
          if (!copied) copied = fallbackCopy(text);
          const toast = document.getElementById('toast');
          if (copied && toast) {
            toast.classList.add('show');
            clearTimeout(toast._t);
            toast._t = setTimeout(() => toast.classList.remove('show'), 1300);
          }
          return copied;
        };

        // ----- Favourites -----
        // Plain localStorage, no accounts. Views call subscribe() and are
        // re-rendered on every change, including their own.
        const KEY = 'favorites';
        const MAX = 60;
        let items = [];
        try {
          const raw = localStorage.getItem(KEY);
          if (raw) items = JSON.parse(raw).filter((s) => typeof s === 'string');
        } catch (e) {}

        const listeners = new Set();

        /**
         * Tells a single symbol apart from a saved combination.
         *
         * Both are stored as plain strings, so the distinction is derived
         * rather than recorded. That keeps collections saved before
         * combinations were addable working without a migration.
         *
         * Counting code points would be wrong: ❤️‍🔥 is four of them and one
         * symbol. Intl.Segmenter counts what a person would call a character.
         */
        const segmenter =
          typeof Intl !== 'undefined' && Intl.Segmenter
            ? new Intl.Segmenter('en', { granularity: 'grapheme' })
            : null;

        function isCombination(value) {
          if (/\s/.test(value)) return true;
          if (segmenter) return [...segmenter.segment(value)].length > 1;
          return [...value].length > 3;
        }

        function persist() {
          try { localStorage.setItem(KEY, JSON.stringify(items)); } catch (e) {}
        }
        function syncCount() {
          const el = document.getElementById('favCount');
          if (!el) return;
          el.textContent = String(items.length);
          el.hidden = items.length === 0;
        }
        function emit() {
          syncCount();
          listeners.forEach((fn) => {
            try { fn(items.slice()); } catch (e) {}
          });
        }

        window.favorites = {
          all: () => items.slice(),
          has: (symbol) => items.includes(symbol),
          isCombination,
          /** Splits the collection into the two shapes the sidebar renders. */
          split() {
            return {
              symbols: items.filter((item) => !isCombination(item)),
              combinations: items.filter(isCombination),
            };
          },
          toggle(symbol) {
            const i = items.indexOf(symbol);
            if (i === -1) {
              items.unshift(symbol);
              if (items.length > MAX) items.length = MAX;
            } else {
              items.splice(i, 1);
            }
            persist();
            emit();
            return items.includes(symbol);
          },
          remove(symbol) {
            const i = items.indexOf(symbol);
            if (i === -1) return;
            items.splice(i, 1);
            persist();
            emit();
          },
          clear() {
            items = [];
            persist();
            emit();
          },
          subscribe(fn) {
            listeners.add(fn);
            fn(items.slice());
            return () => listeners.delete(fn);
          },
          /**
           * Repaints every save control currently in the DOM. Called on every
           * store change, and by pages that render cards themselves after the
           * store has already settled.
           */
          syncIcons() {
            const saved = new Set(items);
            document.querySelectorAll('[data-fav]').forEach((button) => {
              const isSaved = saved.has(button.dataset.fav);
              button.textContent = isSaved ? '♥' : '♡';
              button.classList.toggle('is-saved', isSaved);
              button.setAttribute(
                'aria-label',
                `${isSaved ? 'Remove' : 'Save'} ${button.dataset.fav} ${isSaved ? 'from' : 'to'} your collection`
              );
            });
          },
        };

        listeners.add(() => window.favorites.syncIcons());

        // Delegated rather than bound per button. Save controls appear in
        // several components, some rendered after this script runs and some
        // created dynamically, and delegation covers all of them without
        // caring about document order.
        document.addEventListener('click', (event) => {
          const button = event.target.closest('[data-fav]');
          if (!button) return;
          event.preventDefault();
          window.favorites.toggle(button.dataset.fav);
        });

        // The nav counter and the save controls are parsed after this script.
        document.addEventListener('DOMContentLoaded', () => {
          syncCount();
          window.favorites.syncIcons();
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#6c4cf5" />
    <meta name="google-site-verification" content={GSC_VERIFICATION} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt ?? title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt ?? title} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <script defer src="/_vercel/insights/script.js"></script>

    {
      graph.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block, null, 2)} />
      ))
    }

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <slot />

    <div class="toast" id="toast">
      <span class="check" aria-hidden="true">✓</span>
      <span>Copied</span>
    </div>

    {/* Theme button wiring. The store and clipboard helper are set up in the
        head; this only needs the button, which exists by now. */}
    <script is:inline>
      (function () {
        const themeBtn = document.getElementById('themeToggle');
        if (!themeBtn) return;
        const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';
        function syncThemeIcon() {
          themeBtn.textContent = isDark() ? '☀' : '☾';
          themeBtn.setAttribute(
            'aria-label',
            isDark() ? 'Switch to light theme' : 'Switch to dark theme'
          );
        }
        themeBtn.addEventListener('click', () => {
          if (isDark()) {
            document.documentElement.removeAttribute('data-theme');
            try { localStorage.setItem('theme', 'light'); } catch (e) {}
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            try { localStorage.setItem('theme', 'dark'); } catch (e) {}
          }
          syncThemeIcon();
        });
        syncThemeIcon();
      })();
    </script>

    <slot name="scripts" />
  </body>
</html>
