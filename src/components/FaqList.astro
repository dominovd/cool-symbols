---
interface Props {
  items: Array<{ question: string; answer: string }>;
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>{item.question}</summary>
        <div class="faq-answer" set:html={item.answer} />
      </details>
    ))
  }
</div>
